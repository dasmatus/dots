#!/bin/sh
# SystemRescue autorun — executed automatically at boot (autoruns=1 on the
# kernel cmdline, injected by the ISO remaster). Mounts the 9p-shared repo
# working tree and hands off to the harness guest runner. All output goes to
# ttyS0 → the host's serial log, where the driver asserts on markers.
echo "=== HARNESS: autorun start ==="
mkdir -p /mnt/dotsrepo
if mount -t 9p -o trans=virtio,version=9p2000.L,access=any dotsrepo /mnt/dotsrepo 2>&1; then
  echo "=== HARNESS: repo mounted ==="
else
  echo "=== HARNESS: FAIL mount-9p ==="
  echo "=== HARNESS: DONE rc=90 ==="
  exit 0
fi
exec /bin/bash /mnt/dotsrepo/tests/guest/run.sh
