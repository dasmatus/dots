.codegraph/
.config
__pycache__/

# VM test leftovers — the interactive NixOS test driver
# (…driverInteractive) drops disk images and state dirs in the cwd.
*.qcow2
vm-state-*/

# Nix + Rust build outputs
rust/**/target/
rust/installer-tui/target/
rust/beamenu/target/
rust/beamenu-canvas/target/
result
result-*
# Secure Boot signing keys (scripts/sign-iso.sh). The private key must never
# be committed; the public MOK.cer may be force-added if wanted. The glob
# (not a bare `secrets/` dir ignore) is what lets the negations below
# re-include the agenix artifacts — git cannot un-ignore files under an
# ignored directory.
secrets/*
!secrets/*.age
!secrets/secrets.nix

# Machine answers the installer restores on first login (dots-clone). They
# stay tracked as generic stubs so the flake evals green — gitignore can't
# hide tracked files, so local copies are parked via
# `git update-index --skip-worktree`; these entries document the intent.
nix/data/facter.json
nix/data/settings.nix
.claude/
# Install-time password hashes written by the installer TUI into the
# STAGED_FLAKE only (rust/installer-tui/src/install.rs). Never committed — a
# hash is offline-crackable. The file is NOT stashed to /var/lib/dots, so the
# dots-clone service (nix/home/base/dots-repo.nix) never restores it into the user's
# git clone; it exists only for the install-time `nixos-install` eval so userborn
# can create the accounts with these hashes on first boot.
nix/secrets.nix

# crash core dumps (core.<pid>). Brave GTK4/Wayland segfaults leave these
# behind, and so does rustfmt. Unanchored, so it catches dumps dropped in a
# crate dir and not just the repo root.
core.[0-9]*
.superpowers/
rust/beamenu-calc/target/
rust/beamenu-status/target/
rust/dots-osd/target/

# devenv (flake/devenv.nix) working state. `.devenv/` holds the profile
# symlink, process logs and the sqlite state devenv keeps per checkout;
# `.devenv.flake.nix` is the wrapper flake it regenerates on every `nix
# develop`. Both are derived from the tracked module and are per-machine, so
# committing either would only produce conflicts.
.devenv/
.devenv.flake.nix
# direnv's `use flake` cache, if enabled locally. Not required by anything in
# this repo — listed because a stale committed copy pins an old store path and
# is confusing to debug.
.direnv/
