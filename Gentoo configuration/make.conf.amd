# These settings were set by the catalyst build script that automatically
# built this stage.
# Please consult /usr/share/portage/config/make.conf.example for a more
# detailed example.
COMMON_FLAGS="-O2 -march=znver2 -pipe -flto=auto"
CFLAGS="${COMMON_FLAGS}"
CXXFLAGS="${COMMON_FLAGS}"
FCFLAGS="${COMMON_FLAGS}"
FFLAGS="${COMMON_FLAGS}"
# AMDGPU llvm-tblgen uses ~3-4 GB per process; keep jobs low enough to avoid OOM
# (14 GiB RAM, no swap — -j16 kills tblgen with SIGKILL / exit 137)
MAKEOPTS="-j8"
LD="ld.lld"
CC="clang"
CPP="clang-cpp" # necessary for xorg-server and possibly other packages
CXX="clang++"
AR="llvm-ar"
NM="llvm-nm"
RANLIB="llvm-ranlib"
LDFLAGS="-fuse-ld=lld"
FEATURES="getbinpkg ccache"
CCACHE_DIR="/var/cache/ccache"
# NOTE: This stage was built with the bindist Use flag enabled

# This sets the language of build output to English.
# Please keep this setting intact when reporting bugs.
LC_MESSAGES=en_US.utf8
USE="X wayland i3wm icons apparmor pipewire standalone systemd flatpak gles2 alsa -d -fortran hardened -rust -ipv6 multilib -ada -qt5 -qt6 -pulseaudio multilib dist-kernel"
GRUB_PLATFORMS="efi-64"
VIDEO_CARDS="amdgpu radeonsi"
ACCEPT_LICENSE="*"
ACCEPT_KEYWORDS="~*"



MODULES_SIGN_KEY="/etc/kernel/certs/signing_key.pem"
MODULES_SIGN_CERT="/etc/kernel/certs/signing_key.crt"
SECUREBOOT_SIGN_KEY="/etc/kernel/certs/signing_key.pem"
SECUREBOOT_SIGN_CERT="/etc/kernel/certs/signing_key.crt"
