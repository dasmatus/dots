// Zellij configuration — Tokyonight theme

// Prefix: Space (mirrors Neovim's Space leader)
// Mirrors nvim binds: sf→f  tn→t  tc→c  nt→n  tt→s  lt→l
keybinds clear-defaults=false {
    normal {
        bind "Space" { SwitchToMode "Tmux"; }
    }
    tmux {
        bind "Escape" { SwitchToMode "Normal"; }

        // Tab management — mirrors <Space>tn / <Space>tc / <Space>nt
        bind "t" { NewTab; SwitchToMode "Normal"; }               // tn = tab new
        bind "c" { CloseFocus; SwitchToMode "Normal"; }           // tc = tab/pane close
        bind "n" { GoToNextTab; SwitchToMode "Normal"; }          // nt = next tab
        bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "," { SwitchToMode "RenameTab"; }

        // Pane / terminal — mirrors <Space>tt (toggle term → new pane)
        bind "s" { NewPane "Down"; SwitchToMode "Normal"; }       // tt → split down (terminal)
        bind "v" { NewPane "Right"; SwitchToMode "Normal"; }      // vertical split

        // File tree placeholder — mirrors <Space>sf (no native equiv; opens new pane)
        bind "f" { NewPane; SwitchToMode "Normal"; }              // sf = side/file pane

        // Diagnostics placeholder — mirrors <Space>lt (no native equiv; scroll = closest)
        bind "l" { SwitchToMode "Scroll"; }                       // lt = list/scroll

        // Layout / zoom
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "Space" { NextSwapLayout; }

        // Pane navigation — hjkl like nvim splits
        bind "h" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "Left"  { MoveFocus "Left";  SwitchToMode "Normal"; }
        bind "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "Down"  { MoveFocus "Down";  SwitchToMode "Normal"; }
        bind "Up"    { MoveFocus "Up";    SwitchToMode "Normal"; }

        bind "d" { Detach; }
        bind "[" { SwitchToMode "Scroll"; }
    }
    shared_except "normal" "locked" {
        bind "Escape" { SwitchToMode "Normal"; }
    }
}

// Tokyonight Night palette
themes {
    tokyonight {
        fg "#c0caf5"
        bg "#1a1b26"
        black "#15161e"
        red "#f7768e"
        green "#9ece6a"
        yellow "#e0af68"
        blue "#7aa2f7"
        magenta "#bb9af7"
        cyan "#7dcfff"
        white "#a9b1d6"
        orange "#ff9e64"
    }
}

theme "tokyonight"

default_layout "default"
default_shell "fish"

// UI options
pane_frames true
simplified_ui false
ui {
    pane_frames {
        rounded_corners true
        hide_session_name false
    }
}

// Session
session_serialization true
serialize_pane_viewport true

// Mouse
mouse_mode true

// Scroll
scroll_buffer_size 10000

// Copy
copy_on_select true
copy_command "xclip -selection clipboard"
