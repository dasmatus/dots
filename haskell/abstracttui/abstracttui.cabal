cabal-version:      2.4
name:               abstracttui
version:            0.1.0
synopsis:           abstracttui-shaped compat layer on reflex-vty
license:            MIT
build-type:         Simple

common shared
  default-language: Haskell2010
  default-extensions: OverloadedStrings
  ghc-options:      -Wall -Wcompat -Widentities -Wincomplete-record-updates
                    -Wredundant-constraints -Wunused-packages

library
  import:           shared
  exposed-modules:  AbstractTUI.Prelude
                    AbstractTUI.Base.Color
                    AbstractTUI.Base.Geom
                    AbstractTUI.Gfx.Bitmap
                    AbstractTUI.Gfx.Mosaic
                    AbstractTUI.Render.Style
                    AbstractTUI.Render.Paint
                    AbstractTUI.Layout.Style
                    AbstractTUI.Theme
                    AbstractTUI.Anim
                    AbstractTUI.Reactive
                    AbstractTUI.View
                    AbstractTUI.Widget.RichText
                    AbstractTUI.Term
                    AbstractTUI.Term.Input
                    AbstractTUI.Driver
                    AbstractTUI.Testing.Capture
  hs-source-dirs:   src
  build-depends:    base >= 4.18 && < 5
                  , vector
                  , text
                  , bytestring
                  , blaze-builder
                  , stm
                  , dependent-sum
                  , reflex
                  , reflex-vty
                  , vty
                  , time
                  , ref-tf

test-suite color-spec
  import:        shared
  type:          exitcode-stdio-1.0
  main-is:       ColorSpec.hs
  hs-source-dirs: tests
  build-depends: base, abstracttui, tasty, tasty-hunit

test-suite paint-spec
  import:        shared
  type:          exitcode-stdio-1.0
  main-is:       PaintSpec.hs
  hs-source-dirs: tests
  build-depends: base, abstracttui, vty, tasty, tasty-hunit

