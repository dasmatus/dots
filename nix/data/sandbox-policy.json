{
  "version": 1,
  "denyPaths": [
    "~/.ssh",
    "~/.config/rbw",
    "~/.local/share/rbw"
  ],
  "apps": {
    "default": {
      "tier": "bwrap",
      "caps": {
        "repo-read": "allow"
      }
    },
    "nix-lint": {
      "tier": "bwrap",
      "caps": {
        "repo-write": "allow",
        "nix-daemon": "allow",
        "net": "allow"
      },
      "paths": [
        {
          "path": "~/.cargo",
          "mode": "rw",
          "state": "allow"
        }
      ]
    },
    "memory-derive": {
      "tier": "bwrap",
      "caps": {
        "repo-read": "allow",
        "postgres": "allow"
      }
    },
    "memory-health": {
      "tier": "bwrap",
      "caps": {
        "postgres": "allow"
      }
    },
    "iso": {
      "tier": "bwrap",
      "caps": {
        "repo-write": "allow",
        "nix-daemon": "allow",
        "net": "allow",
        "settings-ro": "allow"
      }
    },
    "iso-full": {
      "tier": "bwrap",
      "caps": {
        "repo-write": "allow",
        "nix-daemon": "allow",
        "net": "allow",
        "settings-ro": "allow"
      }
    },
    "nix-smoke": {
      "tier": "bwrap",
      "caps": {
        "repo-write": "allow",
        "nix-daemon": "allow",
        "net": "allow",
        "settings-ro": "allow"
      }
    },
    "clean": {
      "tier": "bwrap",
      "caps": {
        "repo-write": "allow"
      }
    },
    "edupage-mcp": {
      "tier": "bwrap",
      "caps": {
        "net": "allow"
      }
    },
    "dots-memory-mcp": {
      "tier": "bwrap",
      "caps": {
        "postgres": "allow"
      }
    },
    "dev": {
      "unconfined": true,
      "reason": "interactive dev shell; needs the real terminal and the user's writable checkout"
    },
    "home-switch": {
      "unconfined": true,
      "reason": "home-manager switch rewrites $HOME and drives the Nix daemon; confining it would deny the whole job"
    },
    "nix-smoke-interactive": {
      "unconfined": true,
      "reason": "drops into the test driver's Python REPL; needs a real terminal"
    },
    "enroll-fido": {
      "unconfined": true,
      "reason": "needs /dev/hidraw* and a physical key tap"
    },
    "global-settings": {
      "unconfined": true,
      "reason": "re-execs under pkexec to write the root-owned settings file"
    },
    "computer-use-linux": {
      "unconfined": true,
      "reason": "needs /dev/uinput, the AT-SPI bus, whole-desktop input control"
    },
    "kitty": {
      "tier": "bwrap",
      "caps": {
        "wayland": "allow",
        "dri": "allow",
        "repo-write": "allow",
        "net": "allow"
      }
    },
    "junction": {
      "tier": "bwrap",
      "caps": {
        "wayland": "allow",
        "net": "allow"
      }
    },
    "bitwarden": {
      "tier": "bwrap",
      "caps": {
        "wayland": "allow",
        "dri": "allow",
        "net": "allow"
      }
    },
    "zed": {
      "tier": "bwrap",
      "caps": {
        "wayland": "allow",
        "dri": "allow",
        "net": "allow",
        "repo-write": "allow"
      }
    },
    "claude-desktop": {
      "tier": "bwrap",
      "caps": {
        "wayland": "allow",
        "dri": "allow",
        "net": "allow"
      }
    }
  }
}
