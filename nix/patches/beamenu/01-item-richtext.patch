diff --git a/lib/item.c b/lib/item.c
index 1d12357..ce3e476 100644
--- a/lib/item.c
+++ b/lib/item.c
@@ -19,9 +19,30 @@ bm_item_free(struct bm_item *item)
 {
     assert(item);
     free(item->text);
+    free(item->subtitle);
+    free(item->accessory);
+    free(item->icon);
+    free(item->section);
     free(item);
 }
 
+/**
+ * Replace one owned string field with a copy of *value*.
+ * Shared by every rich-row setter below; on allocation failure the old
+ * value is left intact so a failed set never blanks the row.
+ */
+static bool
+bm_item_set_field(char **field, const char *value)
+{
+    char *copy = NULL;
+    if (value && !(copy = bm_strdup(value)))
+        return false;
+
+    free(*field);
+    *field = copy;
+    return true;
+}
+
 void
 bm_item_set_userdata(struct bm_item *item, void *userdata)
 {
@@ -57,4 +78,60 @@ bm_item_get_text(const struct bm_item *item)
     return item->text;
 }
 
+bool
+bm_item_set_subtitle(struct bm_item *item, const char *subtitle)
+{
+    assert(item);
+    return bm_item_set_field(&item->subtitle, subtitle);
+}
+
+const char*
+bm_item_get_subtitle(const struct bm_item *item)
+{
+    assert(item);
+    return item->subtitle;
+}
+
+bool
+bm_item_set_accessory(struct bm_item *item, const char *accessory)
+{
+    assert(item);
+    return bm_item_set_field(&item->accessory, accessory);
+}
+
+const char*
+bm_item_get_accessory(const struct bm_item *item)
+{
+    assert(item);
+    return item->accessory;
+}
+
+bool
+bm_item_set_icon(struct bm_item *item, const char *icon)
+{
+    assert(item);
+    return bm_item_set_field(&item->icon, icon);
+}
+
+const char*
+bm_item_get_icon(const struct bm_item *item)
+{
+    assert(item);
+    return item->icon;
+}
+
+bool
+bm_item_set_section(struct bm_item *item, const char *section)
+{
+    assert(item);
+    return bm_item_set_field(&item->section, section);
+}
+
+const char*
+bm_item_get_section(const struct bm_item *item)
+{
+    assert(item);
+    return item->section;
+}
