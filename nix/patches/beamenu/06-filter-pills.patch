+/**
+ * Free the pill bar bm_menu_set_pills replaces or clears, and reset
+ * pill_active to 0 with it: bm_menu_get_active_pill's contract is "0 when no
+ * pill bar is set", and leaving a stale index here would break exactly that
+ * whenever the bar is cleared with bm_menu_set_pills(menu, "", ...).
+ */
+static void
+bm_pills_free(struct bm_menu *menu)
+{
+    for (uint32_t i = 0; i < menu->pill_count; ++i)
+        free(menu->pills[i].label);
+    free(menu->pills);
+    menu->pills = NULL;
+    menu->pill_count = 0;
+    menu->pill_active = 0;
+}
+
+void
+bm_menu_set_pills(struct bm_menu *menu, const char *spec, uint32_t active)
+{
+    assert(menu);
+
+    bm_pills_free(menu);
+
+    if (!spec || !*spec)
+        return;
+
+    char *copy = bm_strdup(spec);
+    if (!copy)
+        return;
+
+    /* Upper bound on how many entries the spec can hold, so the array can be
+     * allocated once rather than grown per entry. */
+    uint32_t max_entries = 1;
+    for (const char *c = spec; *c; ++c) {
+        if (*c == '\x1f')
+            max_entries++;
+    }
+
+    struct bm_pill *pills = calloc(max_entries, sizeof(struct bm_pill));
+    if (!pills) {
+        free(copy);
+        return;
+    }
+
+    uint32_t n = 0;
+    char *saveptr = NULL;
+    for (char *tok = strtok_r(copy, "\x1f", &saveptr); tok && n < max_entries; tok = strtok_r(NULL, "\x1f", &saveptr)) {
+        /* Split on the rightmost ':' so a label is free to contain the
+         * character itself; only the trailing run of digits is the count. */
+        char *sep = strrchr(tok, ':');
+        uint32_t count = 0;
+        if (sep) {
+            count = (uint32_t)strtoul(sep + 1, NULL, 10);
+            *sep = 0;
+        }
+
+        if (!(pills[n].label = bm_strdup(tok)))
+            continue;
+        pills[n].count = count;
+        n++;
+    }
+
+    free(copy);
+
+    menu->pills = pills;
+    menu->pill_count = n;
+    /* BM_PILL_NONE has to survive the clamp: it is a deliberate "nothing is
+     * active", not an index that ran off the end. */
+    if (n == 0)
+        menu->pill_active = 0;
+    else if (active == BM_PILL_NONE)
+        menu->pill_active = BM_PILL_NONE;
+    else
+        menu->pill_active = (active < n ? active : n - 1);
+    menu->dirty = true;
+}
+
+uint32_t
+bm_menu_get_active_pill(struct bm_menu *menu)
+{
+    assert(menu);
+
+    return menu->pill_active;
+}
+
