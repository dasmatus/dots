diff --git a/lib/renderers/pills.cpp b/lib/renderers/pills.cpp
new file mode 100644
index 0000000..c4cbb28
--- /dev/null
+++ b/lib/renderers/pills.cpp
@@ -0,0 +1,66 @@
+/**
+ * Pill bar scroll geometry.
+ *
+ * Split out of cairo_renderer.h because it is the one part of the bar that is
+ * pure arithmetic: no cairo context, no pango measurement, no menu state. That
+ * makes it the part worth testing on its own, and it is why this is C++ while
+ * the drawing around it stays C. Nothing here touches the STL, exceptions or
+ * RTTI, so the archive links into the C renderers without pulling libstdc++.
+ */
+
+#include "renderers/pills.h"
+
+#include <cstdint>
+
+namespace {
+
+/// Total width of `count` capsules laid end to end with `gap` between them.
+constexpr std::uint32_t run_width(const std::uint32_t *widths, std::uint32_t count, std::uint32_t gap)
+{
+    std::uint32_t total = 0;
+    for (std::uint32_t i = 0; i < count; ++i) {
+        total += widths[i];
+        if (i + 1 < count)
+            total += gap;
+    }
+    return total;
+}
+
+/// Left edge of capsule `index` within the run.
+constexpr std::uint32_t left_edge(const std::uint32_t *widths, std::uint32_t index, std::uint32_t gap)
+{
+    std::uint32_t x = 0;
+    for (std::uint32_t i = 0; i < index; ++i)
+        x += widths[i] + gap;
+    return x;
+}
+
+} // namespace
+
+extern "C" std::uint32_t
+bm_pills_scroll_offset(const std::uint32_t *widths, std::uint32_t count, std::uint32_t focus,
+                       std::uint32_t gap, std::uint32_t viewport)
+{
+    if (!widths || count == 0 || focus >= count)
+        return 0;
+
+    const std::uint32_t total = run_width(widths, count, gap);
+    if (total <= viewport)
+        return 0;
+
+    const std::uint32_t furthest = total - viewport;
+    const std::uint32_t left = left_edge(widths, focus, gap);
+    const std::uint32_t centre = left + widths[focus] / 2;
+    const std::uint32_t half = viewport / 2;
+
+    std::uint32_t offset = (centre > half ? centre - half : 0);
+    if (offset > furthest)
+        offset = furthest;
+
+    /* Only fires when the capsule is wider than the viewport: centring it
+     * would then push its own left edge off screen. */
+    if (offset > left)
+        offset = left;
+
+    return offset;
+}
