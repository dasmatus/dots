+/**
+ * Free the pill bar bm_menu_set_pills replaces or clears.
+ */
+static void
+bm_pills_free(struct bm_menu *menu)
+{
+    for (uint32_t i = 0; i < menu->pill_count; ++i)
+        free(menu->pills[i].label);
+    free(menu->pills);
+    menu->pills = NULL;
+    menu->pill_count = 0;
+}
+
+void
+bm_menu_set_pills(struct bm_menu *menu, const char *spec, uint32_t active)
+{
+    assert(menu);
+
+    bm_pills_free(menu);
+
+    if (!spec || !*spec)
+        return;
+
+    char *copy = bm_strdup(spec);
+    if (!copy)
+        return;
+
+    /* Upper bound on how many entries the spec can hold, so the array can be
+     * allocated once rather than grown per entry. */
+    uint32_t max_entries = 1;
+    for (const char *c = spec; *c; ++c) {
+        if (*c == '\x1f')
+            max_entries++;
+    }
+
+    struct bm_pill *pills = calloc(max_entries, sizeof(struct bm_pill));
+    if (!pills) {
+        free(copy);
+        return;
+    }
+
+    uint32_t n = 0;
+    char *saveptr = NULL;
+    for (char *tok = strtok_r(copy, "\x1f", &saveptr); tok && n < max_entries; tok = strtok_r(NULL, "\x1f", &saveptr)) {
+        /* Split on the rightmost ':' so a label is free to contain the
+         * character itself; only the trailing run of digits is the count. */
+        char *sep = strrchr(tok, ':');
+        uint32_t count = 0;
+        if (sep) {
+            count = (uint32_t)strtoul(sep + 1, NULL, 10);
+            *sep = 0;
+        }
+
+        if (!(pills[n].label = bm_strdup(tok)))
+            continue;
+        pills[n].count = count;
+        n++;
+    }
+
+    free(copy);
+
+    menu->pills = pills;
+    menu->pill_count = n;
+    menu->pill_active = (n > 0 ? (active < n ? active : n - 1) : 0);
+    menu->dirty = true;
+}
+
+uint32_t
+bm_menu_get_active_pill(struct bm_menu *menu)
+{
+    assert(menu);
+
+    return menu->pill_active;
+}
+
 void
 bm_menu_set_cursor_height(struct bm_menu *menu, uint32_t cursor_height)
 {
@@ -1088,6 +1167,20 @@ bm_menu_run_with_key(struct bm_menu *menu, enum bm_key key, uint32_t unicode)
 {
     assert(menu);

+    /* Tab/Shift+Tab cycle the active pill instead of their stock bindings
+     * (highlight-next, copy-to-filter) whenever the rich layout has a pill
+     * bar to cycle. Handled here, ahead of everything else including vim
+     * bindings, so neither stock action nor bm_menu_filter below ever sees
+     * these keys while a pill bar is set. */
+    if (menu->rich_rows && menu->pill_count > 0 && (key == BM_KEY_TAB || key == BM_KEY_SHIFT_TAB)) {
+        if (key == BM_KEY_TAB)
+            menu->pill_active = (menu->pill_active + 1) % menu->pill_count;
+        else
+            menu->pill_active = (menu->pill_active == 0 ? menu->pill_count - 1 : menu->pill_active - 1);
+        menu->dirty = true;
+        return BM_RUN_RESULT_RUNNING;
+    }
+
     uint32_t count;
     bm_menu_get_filtered_items(menu, &count);

