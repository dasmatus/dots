+/* Layout constants for the filter pill bar. Values the design left
+ * unspecified (internal pill padding, the gap between the dot/label/count
+ * runs) were chosen to read as a scaled-down version of the row gutters
+ * already used above: pad_x/gutter is 10px there, so 12px inside a shorter
+ * capsule and 6px between its three runs keep the same rough proportion. */
+#define BM_PILLS_ROW_PAD_X 20
+#define BM_PILLS_ROW_PAD_Y 14
+#define BM_PILLS_GAP 8
+#define BM_PILL_PAD_X 12
+#define BM_PILL_PAD_Y 8
+#define BM_PILL_DOT 6
+#define BM_PILL_RUN_GAP 6
+#define BM_PILL_COUNT_PT 10.0
+#define BM_PILL_COUNT_ALPHA 0.55f
+#define BM_PILL_ACTIVE_DOT_ALPHA 0.45f
+#define BM_PILL_CURRENT_RING_OFFSET 2.0
+#define BM_PILL_CURRENT_RING_ALPHA 0.2f
+
+/**
+ * Variant of bm_pango_get_layout() that overrides the font's point size.
+ * The pill bar's count run is the only caller: it is drawn smaller than the
+ * configured item font, so it needs its own PangoFontDescription rather than
+ * paint->font's.
+ */
+static inline PangoLayout*
+bm_pango_get_layout_sized(struct cairo *cairo, struct cairo_paint *paint, const char *buffer, double points)
+{
+    PangoLayout *layout = pango_cairo_create_layout(cairo->cr);
+    pango_layout_set_text(layout, buffer, -1);
+    PangoFontDescription *desc = pango_font_description_from_string(paint->font);
+    pango_font_description_set_size(desc, (gint)(points * PANGO_SCALE));
+    pango_layout_set_font_description(layout, desc);
+    pango_layout_set_single_paragraph_mode(layout, 1);
+    pango_font_description_free(desc);
+    return layout;
+}
+
+static inline uint32_t
+bm_cairo_run_width_sized(struct cairo *cairo, struct cairo_paint *paint, const char *text, double points)
+{
+    if (!text || !*text)
+        return 0;
+    PangoLayout *layout = bm_pango_get_layout_sized(cairo, paint, text, points);
+    int w, h;
+    pango_layout_get_pixel_size(layout, &w, &h);
+    g_object_unref(layout);
+    return (uint32_t)w;
+}
+
+/**
+ * Sized counterpart to bm_cairo_draw_run(): same NOTE about the (r, b, g, a)
+ * argument order applies here.
+ */
+static inline uint32_t
+bm_cairo_draw_run_sized(struct cairo *cairo, struct cairo_paint *paint, const struct cairo_color *color,
+                        const char *text, int32_t x, int32_t baseline_y, int32_t max_width, double points)
+{
+    if (!text || !*text || max_width <= 0)
+        return 0;
+
+    PangoLayout *layout = bm_pango_get_layout_sized(cairo, paint, text, points);
+    pango_cairo_update_layout(cairo->cr, layout);
+
+    int w, h;
+    pango_layout_get_pixel_size(layout, &w, &h);
+    int base = pango_layout_get_baseline(layout) / PANGO_SCALE;
+
+    cairo_set_source_rgba(cairo->cr, color->r, color->b, color->g, color->a);
+    cairo_move_to(cairo->cr, x, baseline_y - base);
+    pango_cairo_show_layout(cairo->cr, layout);
+    g_object_unref(layout);
+
+    return (uint32_t)MIN(w, max_width);
+}
+
+/**
+ * Height of the pill bar row, or 0 when rich mode has no pills to draw.
+ *
+ * 14px of padding above and below a single row of capsules; the capsule
+ * itself is the item font's own ascent+descent (ascii_height, as measured by
+ * the caller) plus 8px of internal padding above and below the label, so it
+ * scales with the configured font instead of a hard-coded pixel height.
+ */
+static inline uint32_t
+bm_cairo_pills_row_height(struct bm_menu *menu, uint32_t ascii_height)
+{
+    if (!menu->rich_rows || menu->pill_count == 0)
+        return 0;
+    return BM_PILLS_ROW_PAD_Y * 2 + ascii_height + BM_PILL_PAD_Y * 2;
+}
+
+/**
+ * Width of one capsule: symmetric padding around the dot, the label and the
+ * count, with a gap before each run.
+ *
+ * Measured on its own because the scroll offset needs every capsule's width
+ * before the first one can be placed.
+ */
+static inline uint32_t
+bm_cairo_pill_width(struct cairo *cairo, struct cairo_paint *paint, const struct bm_pill *pill)
+{
+    char count_text[16];
+    snprintf(count_text, sizeof(count_text), "%u", pill->count);
+
+    const uint32_t label_w = bm_cairo_run_width(cairo, paint, pill->label);
+    const uint32_t count_w = bm_cairo_run_width_sized(cairo, paint, count_text, BM_PILL_COUNT_PT);
+    return BM_PILL_PAD_X * 2 + BM_PILL_DOT + BM_PILL_RUN_GAP + label_w + BM_PILL_RUN_GAP + count_w;
+}
+
+/**
+ * Draw the filter pill bar between the search row and the list: one capsule
+ * per bm_menu_set_pills() entry, each a leading dot, the label, and the count
+ * in a smaller, dimmer run.
+ *
+ * Three states, matching what a keyboard-only launcher can actually reach.
+ * The active (filtering) capsule, menu->pill_active, is filled in
+ * BM_COLOR_HIGHLIGHTED_BG/_FG with its dot darkened to 45% alpha of the text
+ * colour. The capsule whose label names the highlighted row's section (see
+ * bm_item_get_section) but is not itself active is "current": a plain outline,
+ * stroked in BM_COLOR_HIGHLIGHTED_BG instead of BM_COLOR_BORDER, with a
+ * second, ~2px-wider concentric stroke at 20% of that colour's alpha as a
+ * focus ring, and BM_COLOR_ITEM_FG text instead of the muted default. Every
+ * other capsule is a plain BM_COLOR_BORDER outline over BM_COLOR_ALTERNATE_FG
+ * text with the dot at full colour. The count run is always at 55% alpha of
+ * whichever text colour the capsule is using.
+ *
+ * Active wins over current when a capsule is both, so neither gets a double
+ * treatment. With menu->pill_active set to BM_PILL_NONE nothing is filtering,
+ * and the current capsule takes the active fill instead of the outline: there
+ * is no chosen capsule left for it to be confused with. That is what a
+ * launcher wants while a search spans every section.
+ *
+ * The run scrolls rather than clipping. Capsules that did not fit used to be
+ * dropped without a trace, which hid whichever sections sorted last. The run
+ * is now offset so the focus capsule stays on screen (the active one, else the
+ * current one, else the first), and drawing is clipped to the row so a
+ * partly-visible capsule is cut cleanly at the edge. See
+ * bm_pills_scroll_offset().
+ */
+static inline void
+bm_cairo_paint_pills_row(struct cairo *cairo, struct cairo_paint *paint, struct bm_menu *menu,
+                         uint32_t width, uint32_t posy, uint32_t row_h)
+{
+    const uint32_t pill_h = row_h - BM_PILLS_ROW_PAD_Y * 2;
+    const uint32_t pill_y = posy + BM_PILLS_ROW_PAD_Y;
+    const double radius = pill_h / 2.0;
+
+    struct cairo_color border_color, default_fg, item_fg, active_bg, active_fg;
+    bm_cairo_color_from_menu_color(menu, BM_COLOR_BORDER, &border_color);
+    bm_cairo_color_from_menu_color(menu, BM_COLOR_ALTERNATE_FG, &default_fg);
+    bm_cairo_color_from_menu_color(menu, BM_COLOR_ITEM_FG, &item_fg);
+    bm_cairo_color_from_menu_color(menu, BM_COLOR_HIGHLIGHTED_BG, &active_bg);
+    bm_cairo_color_from_menu_color(menu, BM_COLOR_HIGHLIGHTED_FG, &active_fg);
+
+    /* The highlighted row's section names the "current" pill; a plain
+     * string match against the label is enough since pill labels are
+     * exactly the provider section names bm_menu_set_pills() was built
+     * from, with no separate identifier to look up. */
+    const struct bm_item *highlighted_item = bm_menu_get_highlighted_item(menu);
+    const char *current_section = (highlighted_item ? bm_item_get_section(highlighted_item) : NULL);
+
+    uint32_t *widths = calloc(menu->pill_count, sizeof(uint32_t));
+    if (!widths)
+        return;
+
+    for (uint32_t i = 0; i < menu->pill_count; ++i)
+        widths[i] = bm_cairo_pill_width(cairo, paint, &menu->pills[i]);
+
+    /* The capsule that must stay on screen: whichever one is filtering, else
+     * the one naming the highlighted row, else the first. */
+    uint32_t focus = 0;
+    if (menu->pill_active != BM_PILL_NONE && menu->pill_active < menu->pill_count) {
+        focus = menu->pill_active;
+    } else if (current_section) {
+        for (uint32_t i = 0; i < menu->pill_count; ++i) {
+            if (!strcmp(menu->pills[i].label, current_section)) {
+                focus = i;
+                break;
+            }
+        }
+    }
+
+    const uint32_t viewport = (width > BM_PILLS_ROW_PAD_X * 2 ? width - BM_PILLS_ROW_PAD_X * 2 : 0);
+    const uint32_t offset = bm_pills_scroll_offset(widths, menu->pill_count, focus, BM_PILLS_GAP, viewport);
+
+    const int32_t baseline = (int32_t)(pill_y + pill_h / 2 + paint->baseline / 2);
+    const int32_t left_edge = (int32_t)BM_PILLS_ROW_PAD_X;
+    const int32_t right_edge = left_edge + (int32_t)viewport;
+
+    /* The current capsule's focus ring sits ~2px outside its outline, so the
+     * clip has to leave room for it or the ring is shaved off at the edges. */
+    cairo_save(cairo->cr);
+    cairo_rectangle(cairo->cr, left_edge - BM_PILL_CURRENT_RING_OFFSET, pill_y - BM_PILL_CURRENT_RING_OFFSET,
+                    viewport + BM_PILL_CURRENT_RING_OFFSET * 2, pill_h + BM_PILL_CURRENT_RING_OFFSET * 2);
+    cairo_clip(cairo->cr);
+
+    int32_t x = left_edge - (int32_t)offset;
+
+    for (uint32_t i = 0; i < menu->pill_count; ++i) {
+        const struct bm_pill *pill = &menu->pills[i];
+        const uint32_t pill_w = widths[i];
+
+        if (x > right_edge)
+            break;
+
+        if (x + (int32_t)pill_w < left_edge) {
+            x += (int32_t)(pill_w + BM_PILLS_GAP);
+            continue;
+        }
+
+        const bool chosen = (i == menu->pill_active);
+        const bool names_row = (current_section && !strcmp(pill->label, current_section));
+        const bool active = chosen || (menu->pill_active == BM_PILL_NONE && names_row);
+        const bool current = (!active && names_row);
+        const struct cairo_color *fg = (active ? &active_fg : (current ? &item_fg : &default_fg));
+
+        char count_text[16];
+        snprintf(count_text, sizeof(count_text), "%u", pill->count);
+
+        const uint32_t label_w = bm_cairo_run_width(cairo, paint, pill->label);
+        const uint32_t count_w = bm_cairo_run_width_sized(cairo, paint, count_text, BM_PILL_COUNT_PT);
+
+        if (active) {
+            bm_cairo_rounded_path(cairo->cr, x, pill_y, pill_w, pill_h, radius);
+            cairo_set_source_rgba(cairo->cr, active_bg.r, active_bg.b, active_bg.g, active_bg.a);
+            cairo_fill(cairo->cr);
+        } else {
+            const struct cairo_color *outline = (current ? &active_bg : &border_color);
+            bm_cairo_rounded_path(cairo->cr, x + 0.5, pill_y + 0.5, pill_w - 1, pill_h - 1, radius - 0.5);
+            cairo_set_source_rgba(cairo->cr, outline->r, outline->b, outline->g, outline->a);
+            cairo_set_line_width(cairo->cr, 1.0);
+            cairo_stroke(cairo->cr);
+
+            if (current) {
+                struct cairo_color ring = active_bg;
+                ring.a *= BM_PILL_CURRENT_RING_ALPHA;
+                bm_cairo_rounded_path(cairo->cr, x + 0.5 - BM_PILL_CURRENT_RING_OFFSET, pill_y + 0.5 - BM_PILL_CURRENT_RING_OFFSET,
+                                      pill_w - 1 + BM_PILL_CURRENT_RING_OFFSET * 2, pill_h - 1 + BM_PILL_CURRENT_RING_OFFSET * 2,
+                                      radius - 0.5 + BM_PILL_CURRENT_RING_OFFSET);
+                cairo_set_source_rgba(cairo->cr, ring.r, ring.b, ring.g, ring.a);
+                cairo_set_line_width(cairo->cr, 1.0);
+                cairo_stroke(cairo->cr);
+            }
+        }
+
+        int32_t cx = x + BM_PILL_PAD_X;
+
+        struct cairo_color dot_color = *fg;
+        if (active)
+            dot_color.a *= BM_PILL_ACTIVE_DOT_ALPHA;
+        cairo_set_source_rgba(cairo->cr, dot_color.r, dot_color.b, dot_color.g, dot_color.a);
+        cairo_arc(cairo->cr, cx + BM_PILL_DOT / 2.0, pill_y + pill_h / 2.0, BM_PILL_DOT / 2.0, 0, 2 * M_PI);
+        cairo_fill(cairo->cr);
+        cx += BM_PILL_DOT + BM_PILL_RUN_GAP;
+
+        bm_cairo_draw_run(cairo, paint, fg, pill->label, cx, baseline, (int32_t)label_w + 1, false);
+        cx += (int32_t)(label_w + BM_PILL_RUN_GAP);
+
+        struct cairo_color count_color = *fg;
+        count_color.a *= BM_PILL_COUNT_ALPHA;
+        bm_cairo_draw_run_sized(cairo, paint, &count_color, count_text, cx, baseline,
+                                (int32_t)count_w + 1, BM_PILL_COUNT_PT);
+
+        x += (int32_t)(pill_w + BM_PILLS_GAP);
+    }
+
+    cairo_restore(cairo->cr);
+    free(widths);
+}
