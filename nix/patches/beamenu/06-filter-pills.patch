new file mode 100644
index 0000000..d514370
--- /dev/null
+++ b/lib/renderers/pills.h
@@ -0,0 +1,38 @@
+#ifndef _BM_PILLS_H_
+#define _BM_PILLS_H_
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * How far left to shift the pill run so capsule `focus` stays on screen.
+ *
+ * The capsules are laid end to end with `gap` between them. When the whole run
+ * fits in `viewport` the answer is 0 and the bar does not move at all.
+ * Otherwise the focus capsule is centred, clamped so the run never scrolls
+ * past either end, and clamped again so a capsule wider than the viewport
+ * shows its left edge rather than its middle.
+ *
+ * Centring rather than scrolling by the minimum amount is deliberate. The
+ * minimum shift pins the focus capsule against the right edge on the way out
+ * and then jumps the whole bar back to 0 as soon as Shift+Tab brings it back
+ * inside, which reads as a glitch. Centring moves about one capsule per Tab in
+ * either direction.
+ *
+ * @param widths width in pixels of each capsule, in draw order.
+ * @param count number of entries in `widths`.
+ * @param focus index of the capsule that must stay visible.
+ * @param gap pixels between adjacent capsules.
+ * @param viewport width in pixels available to the run.
+ * @return uint32_t pixels to subtract from every capsule's x position.
+ */
+uint32_t bm_pills_scroll_offset(const uint32_t *widths, uint32_t count, uint32_t focus, uint32_t gap, uint32_t viewport);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _BM_PILLS_H_ */
