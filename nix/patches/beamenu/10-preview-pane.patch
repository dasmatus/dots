diff --git a/lib/renderers/preview.cpp b/lib/renderers/preview.cpp
new file mode 100644
index 0000000..e9fff89
--- /dev/null
+++ b/lib/renderers/preview.cpp
@@ -0,0 +1,32 @@
+/**
+ * Preview column geometry.
+ *
+ * Split out of cairo_renderer.h for the same reason pills.cpp and rows.cpp
+ * were: it is arithmetic over three numbers, with no cairo context and no
+ * menu state, which makes it the part worth testing on its own. Nothing here
+ * touches the STL, exceptions or RTTI, so the archive links into the C
+ * renderers without pulling libstdc++.
+ */
+
+#include "renderers/preview.h"
+
+#include <cstdint>
+
+extern "C" struct bm_preview_split
+bm_preview_columns(std::uint32_t panel_width, std::uint32_t wanted)
+{
+    struct bm_preview_split split = { panel_width, 0 };
+
+    if (wanted == 0 || panel_width <= BM_PREVIEW_MIN_LIST)
+        return split;
+
+    const std::uint32_t room = panel_width - BM_PREVIEW_MIN_LIST;
+    const std::uint32_t width = (wanted < room ? wanted : room);
+
+    if (width < BM_PREVIEW_MIN_COLUMN)
+        return split;
+
+    split.list_width = panel_width - width;
+    split.preview_width = width;
+    return split;
+}
diff --git a/lib/renderers/preview.h b/lib/renderers/preview.h
new file mode 100644
index 0000000..39e14b7
--- /dev/null
+++ b/lib/renderers/preview.h
@@ -0,0 +1,63 @@
+#ifndef _BM_PREVIEW_H_
+#define _BM_PREVIEW_H_
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Narrowest list column worth keeping, in logical pixels.
+ *
+ * A launcher row is a title over a subtitle beside an icon. Below this the
+ * subtitle is ellipsised into uselessness, at which point the preview has
+ * eaten the thing it was meant to preview.
+ */
+#define BM_PREVIEW_MIN_LIST 260u
+
+/**
+ * Narrowest preview column worth reserving, in logical pixels.
+ *
+ * A sliver of a pane reads as a rendering fault rather than as a feature, so
+ * a column that would come out narrower than this is dropped outright and the
+ * list gets the whole panel back.
+ */
+#define BM_PREVIEW_MIN_COLUMN 200u
+
+/**
+ * How a panel's width divides between the result list and the preview column.
+ */
+struct bm_preview_split {
+    /** Logical pixels the list, its headings and the pill bar lay out in. */
+    uint32_t list_width;
+    /** Logical pixels reserved for the preview, 0 when there is no column. */
+    uint32_t preview_width;
+};
+
+/**
+ * Divide `panel_width` between the list and a preview column of `wanted`.
+ *
+ * The renderer draws nothing inside the preview column; it only stops the
+ * list from running into it and puts a hairline on the boundary. What fills
+ * the column is a separate surface, which is why this returns the geometry
+ * rather than painting anything.
+ *
+ * Three ways to end up with no column at all, each collapsing to the full
+ * panel width for the list: nothing was asked for, the panel is too narrow to
+ * seat BM_PREVIEW_MIN_LIST beside anything, or what is left after that
+ * reservation falls under BM_PREVIEW_MIN_COLUMN. A caller therefore never has
+ * to bounds-check `wanted` itself, and a panel that shrinks below the split's
+ * working range degrades to the list-only layout instead of to a broken one.
+ *
+ * @param panel_width logical width of the whole panel.
+ * @param wanted logical width asked for, 0 to disable the column.
+ * @return struct bm_preview_split the two column widths, summing to panel_width.
+ */
+struct bm_preview_split bm_preview_columns(uint32_t panel_width, uint32_t wanted);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _BM_PREVIEW_H_ */
