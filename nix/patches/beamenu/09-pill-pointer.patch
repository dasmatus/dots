diff --git a/lib/renderers/wayland/wayland.c b/lib/renderers/wayland/wayland.c
index c8e38bb..5324f74 100644
--- a/lib/renderers/wayland/wayland.c
+++ b/lib/renderers/wayland/wayland.c
@@ -76,6 +76,90 @@ render(struct bm_menu *menu)
     return true;
 }
 
+/**
+ * Pointer input for the pill bar: a horizontal swipe walks it, a click jumps
+ * straight to a capsule, and a click on the capsule already filtering clears
+ * the filter.
+ *
+ * Swiping returns Tab's own keys rather than moving menu->pill_active here,
+ * so there stays one implementation of "the next pill", wraparound and
+ * BM_PILL_NONE start included.
+ *
+ * Clicking cannot go through a key, since no key names a particular capsule,
+ * so it writes pill_active. The const on `menu` is the renderer vtable's and
+ * is nominal: bm_menu is heap-allocated, never a const object, and this
+ * function already reaches non-const renderer state through the same pointer.
+ * The client re-reads bm_menu_get_active_pill() after every run_with_key(),
+ * which is the same path Tab's move travels back on.
+ *
+ * The event is consumed either way. Nothing else in beamenu reads
+ * pointer_event, and leaving a handled click in it would replay it on the
+ * next keystroke.
+ */
+static enum bm_key
+bm_wayland_poll_pill_pointer(const struct bm_menu *menu, struct wayland *wayland)
+{
+    struct pointer_event *event = &wayland->input.pointer_event;
+
+    if (menu->pill_count == 0 || menu->pills == NULL) {
+        memset(event, 0, sizeof(*event));
+        return BM_KEY_NONE;
+    }
+
+    if ((event->event_mask & POINTER_EVENT_AXIS)
+        && event->axes[WL_POINTER_AXIS_HORIZONTAL_SCROLL].valid) {
+        const wl_fixed_t value = event->axes[WL_POINTER_AXIS_HORIZONTAL_SCROLL].value;
+        memset(event, 0, sizeof(*event));
+        if (value > 0)
+            return BM_KEY_TAB;
+        if (value < 0)
+            return BM_KEY_SHIFT_TAB;
+        return BM_KEY_NONE;
+    }
+
+    if (!(event->event_mask & POINTER_EVENT_BUTTON)
+        || event->button != BTN_LEFT
+        || !(event->state & WL_POINTER_BUTTON_STATE_PRESSED))
+        return BM_KEY_NONE;
+
+    const int32_t px = wl_fixed_to_int(event->surface_x);
+    const int32_t py = wl_fixed_to_int(event->surface_y);
+    memset(event, 0, sizeof(*event));
+
+    /* A bar that has not been painted has no band, so a click before the
+     * first frame lands on nothing rather than on last frame's geometry. */
+    if (menu->pill_bar_h == 0
+        || py < (int32_t)menu->pill_bar_y
+        || py >= (int32_t)(menu->pill_bar_y + menu->pill_bar_h))
+        return BM_KEY_NONE;
+
+    int32_t *xs = calloc(menu->pill_count, sizeof(int32_t));
+    uint32_t *widths = calloc(menu->pill_count, sizeof(uint32_t));
+    if (!xs || !widths) {
+        free(xs);
+        free(widths);
+        return BM_KEY_NONE;
+    }
+    for (uint32_t i = 0; i < menu->pill_count; ++i) {
+        xs[i] = menu->pills[i].draw_x;
+        widths[i] = menu->pills[i].draw_w;
+    }
+
+    const uint32_t hit = bm_pills_hit(xs, widths, menu->pill_count, px);
+    free(xs);
+    free(widths);
+
+    if (hit == BM_PILLS_NO_HIT)
+        return BM_KEY_NONE;
+
+    struct bm_menu *target = (struct bm_menu *)menu;
+    /* Clicking the capsule that is already filtering clears the filter, so
+     * the same click both engages and undoes it. */
+    target->pill_active = (menu->pill_active == hit ? BM_PILL_NONE : hit);
+    target->dirty = true;
+    return BM_KEY_NONE;
+}
+
 static enum bm_key
 poll_key(const struct bm_menu *menu, unsigned int *unicode)
 {
@@ -83,6 +167,18 @@ poll_key(const struct bm_menu *menu, unsigned int *unicode)
     assert(wayland && unicode);
     *unicode = 0;
 
+    /* Pointer input for the pill bar is consumed here rather than through the
+     * bm_pointer path, because beamenu drives the loop with
+     * bm_menu_run_with_key() and never calls poll_pointer(). Doing it here
+     * also puts the result in the same turn as the key that would have caused
+     * it: the client re-reads bm_menu_get_active_pill() after every
+     * run_with_key(), so a pill moved now is filtered on immediately, where a
+     * pill moved during the next render() would sit unnoticed until the user
+     * pressed something. */
+    const enum bm_key pointer_key = bm_wayland_poll_pill_pointer(menu, wayland);
+    if (pointer_key != BM_KEY_NONE)
+        return pointer_key;
+
     if (wayland->input.sym == XKB_KEY_NoSymbol)
         return BM_KEY_NONE;
 
