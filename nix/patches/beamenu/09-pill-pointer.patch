diff --git a/lib/renderers/pills.cpp b/lib/renderers/pills.cpp
index c4cbb28..a19e9c8 100644
--- a/lib/renderers/pills.cpp
+++ b/lib/renderers/pills.cpp
@@ -64,3 +64,19 @@ bm_pills_scroll_offset(const std::uint32_t *widths, std::uint32_t count, std::ui
 
     return offset;
 }
+
+extern "C" std::uint32_t
+bm_pills_hit(const std::int32_t *xs, const std::uint32_t *widths, std::uint32_t count, std::int32_t px)
+{
+    if (!xs || !widths)
+        return BM_PILLS_NO_HIT;
+
+    for (std::uint32_t i = 0; i < count; ++i) {
+        /* Half-open on the right so two capsules laid end to end with no gap
+         * cannot both claim the same pixel. */
+        if (px >= xs[i] && px < xs[i] + static_cast<std::int32_t>(widths[i]))
+            return i;
+    }
+
+    return BM_PILLS_NO_HIT;
+}
