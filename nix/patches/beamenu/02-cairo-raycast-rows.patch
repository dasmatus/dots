+/**
+ * Icon cache.
+ *
+ * The menu repaints on every keystroke, and decoding an SVG once per row per
+ * frame is far too slow to keep a launcher responsive. Entries are keyed by
+ * (path, size) and never evicted: a session's icon set is bounded by the
+ * number of installed applications, and each surface costs at most
+ * size * size * 4 bytes. A failed load is cached as a NULL surface so a
+ * broken path is retried at most once.
+ */
+#define BM_ICON_CACHE_MAX 512
+
+struct bm_icon_entry {
+    char *path;
+    uint32_t size;
+    cairo_surface_t *surface;
+};
+
+static struct bm_icon_entry icon_cache[BM_ICON_CACHE_MAX];
+static size_t icon_cache_len = 0;
+
+static inline bool
+bm_cairo_has_suffix(const char *str, const char *suffix)
+{
+    size_t l = strlen(str), s = strlen(suffix);
+    return l >= s && !strcasecmp(str + l - s, suffix);
+}
+
+/**
+ * Decode *path* into a size*size ARGB32 surface.
+ *
+ * SVG goes through librsvg and PNG through cairo's own loader, which between
+ * them cover every format XDG icon themes actually ship. Deliberately not
+ * gdk-pixbuf: its format support is spread across loader modules discovered
+ * at runtime via GDK_PIXBUF_MODULE_FILE, which would make icon rendering
+ * depend on an environment variable surviving all the way to the wrapper.
+ *
+ * Returns NULL for an unreadable or unsupported file; callers draw an empty
+ * gutter rather than an error glyph.
+ */
+static inline cairo_surface_t *
+bm_cairo_icon_load(const char *path, uint32_t size)
+{
+    for (size_t i = 0; i < icon_cache_len; ++i) {
+        if (icon_cache[i].size == size && !strcmp(icon_cache[i].path, path))
+            return icon_cache[i].surface;
+    }
+
+    cairo_surface_t *surface = NULL;
+
+    if (bm_cairo_has_suffix(path, ".svg")) {
+        RsvgHandle *handle = rsvg_handle_new_from_file(path, NULL);
+        if (handle) {
+            surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, size, size);
+            cairo_t *cr = cairo_create(surface);
+            RsvgRectangle viewport = { 0.0, 0.0, (double)size, (double)size };
+            if (!rsvg_handle_render_document(handle, cr, &viewport, NULL)) {
+                cairo_surface_destroy(surface);
+                surface = NULL;
+            }
+            cairo_destroy(cr);
+            g_object_unref(handle);
+        }
+    } else if (bm_cairo_has_suffix(path, ".png")) {
+        cairo_surface_t *png = cairo_image_surface_create_from_png(path);
+        if (cairo_surface_status(png) == CAIRO_STATUS_SUCCESS) {
+            double sw = cairo_image_surface_get_width(png);
+            double sh = cairo_image_surface_get_height(png);
+            if (sw > 0 && sh > 0) {
+                surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, size, size);
+                cairo_t *cr = cairo_create(surface);
+                cairo_scale(cr, (double)size / sw, (double)size / sh);
+                cairo_set_source_surface(cr, png, 0, 0);
+                cairo_paint(cr);
+                cairo_destroy(cr);
+            }
+        }
+        cairo_surface_destroy(png);
+    }
+
+    if (icon_cache_len < BM_ICON_CACHE_MAX) {
+        char *copy = bm_strdup(path);
+        if (copy) {
+            icon_cache[icon_cache_len].path = copy;
+            icon_cache[icon_cache_len].size = size;
+            icon_cache[icon_cache_len].surface = surface;
+            icon_cache_len++;
+        }
+    }
+
+    return surface;
+}
+
+/**
+ * Draw one Pango run at (x, baseline_y) in *color*, clipped to *max_width*
+ * and ellipsized at the end. Returns the drawn width in pixels.
+ *
+ * NOTE the (r, b, g, a) argument order to cairo_set_source_rgba, matching
+ * every other call site in this file: bm_menu_set_color parses "#RRGGBB"
+ * with sscanf("#%2x%2x%2x%2x", &r, &b, &g, &a), so struct bm_hex_color's
+ * .g field holds the blue byte and .b holds the green one. The two swaps
+ * cancel; breaking the pairing here would transpose green and blue.
+ */
+static inline uint32_t
+bm_cairo_draw_run(struct cairo *cairo, struct cairo_paint *paint, const struct cairo_color *color,
+                  const char *text, int32_t x, int32_t baseline_y, int32_t max_width, bool ellipsize)
+{
+    if (!text || !*text || max_width <= 0)
+        return 0;
+
+    PangoLayout *layout = bm_pango_get_layout(cairo, paint, text);
+    if (ellipsize) {
+        pango_layout_set_width(layout, max_width * PANGO_SCALE);
+        pango_layout_set_ellipsize(layout, PANGO_ELLIPSIZE_END);
+    }
+    pango_cairo_update_layout(cairo->cr, layout);
+
+    int w, h;
+    pango_layout_get_pixel_size(layout, &w, &h);
+    int base = pango_layout_get_baseline(layout) / PANGO_SCALE;
+
+    cairo_set_source_rgba(cairo->cr, color->r, color->b, color->g, color->a);
+    cairo_move_to(cairo->cr, x, baseline_y - base);
+    pango_cairo_show_layout(cairo->cr, layout);
+    g_object_unref(layout);
+
+    return (uint32_t)MIN(w, max_width);
+}
+
+static inline uint32_t
+bm_cairo_run_width(struct cairo *cairo, struct cairo_paint *paint, const char *text)
+{
+    if (!text || !*text)
+        return 0;
+    PangoLayout *layout = bm_pango_get_layout(cairo, paint, text);
+    int w, h;
+    pango_layout_get_pixel_size(layout, &w, &h);
+    g_object_unref(layout);
+    return (uint32_t)w;
+}
+
+/**
+ * Rich (Raycast-style) vertical row painting.
+ *
+ * Owns the whole list region below the search row. It replaces, rather
+ * than extends, the classic row loop: it assumes lines > 0 and
+ * BM_LINES_DOWN, which is all beamenu ever configures, so none of the
+ * fixed-height / lines-up index arithmetic applies.
+ *
+ * Each row is two text lines stacked in one row_h slot, left to right:
+ *
+ *   pad_x | pill: gutter [icon] gap Title            Accessory      gutter |
+ *   pad_x | pill: gutter Subtitle ...                               gutter |
+ *
+ * The icon is centred against line 1 only, not the row as a whole. The
+ * subtitle starts at the same x as the icon (pad_x + gutter) rather than
+ * past it, so it runs the full row width under the icon instead of lining
+ * up with the title. Title baseline sits at ~40% of row_h, subtitle
+ * baseline at ~78%, both fixed fractions rather than font-metric centring,
+ * so the two lines keep their split as row_h changes.
+ *
+ * A section heading is emitted above the first item whose section differs
+ * from the previous one's, and consumes one row slot.
+ */
+static inline void
+bm_cairo_paint_rich_rows(struct cairo *cairo, struct cairo_paint *paint, struct bm_menu *menu,
+                         struct bm_item **items, uint32_t count, uint32_t width,
+                         uint32_t max_height, uint32_t start_y, struct cairo_paint_result *out_result)
+{
+    const uint32_t row_h = (menu->line_height > 0 ? menu->line_height : 52);
+    const uint32_t icon_size = (menu->icon_size > 0 ? menu->icon_size : 24);
+    const uint32_t pad_x = 10, gutter = 10, gap = 12;
+    const uint32_t head_h = row_h * 2 / 3;
+
+    struct cairo_color fg, bg, muted, head_fg;
+    bm_cairo_color_from_menu_color(menu, BM_COLOR_ITEM_FG, &fg);
+    bm_cairo_color_from_menu_color(menu, BM_COLOR_ALTERNATE_FG, &muted);
+    bm_cairo_color_from_menu_color(menu, BM_COLOR_TITLE_FG, &head_fg);
+
+    /* Keep the highlighted row on screen: page on the highlight index, in
+     * whole rows, ignoring headings (they ride along with their group). */
+    const uint32_t lines = (menu->lines > 0 ? menu->lines : 1);
+    const uint32_t page = (menu->index / lines) * lines;
+
+    uint32_t posy = start_y;
+    const char *prev_section = NULL;
+
+    /* A heading only makes sense above its own group, so the first drawn row
+     * always re-emits its heading even mid-list. */
+    if (page < count)
+        prev_section = NULL;
+
+    for (uint32_t i = page; i < count && posy + row_h <= max_height; ++i) {
+        struct bm_item *item = items[i];
+        const char *section = bm_item_get_section(item);
+
+        if (section && *section && (!prev_section || strcmp(prev_section, section))) {
+            if (posy + head_h + row_h > max_height)
+                break;
+            bm_cairo_draw_run(cairo, paint, &head_fg, section,
+                              pad_x + gutter, posy + head_h * 2 / 3,
+                              (int32_t)(width - (pad_x + gutter) * 2), true);
+            posy += head_h;
+            out_result->height = posy;
+        }
+        prev_section = section;
+
+        const bool highlighted = (item == bm_menu_get_highlighted_item(menu));
+
+        /* Muted text for this row: BM_COLOR_ALTERNATE_FG everywhere except
+         * the highlighted pill, where that global muted tone is gray drawn
+         * on the accent fill rather than on the panel background it was
+         * chosen against. There, derive the row's muted tone from the
+         * highlighted fg itself, dimmed, so subtitle and accessory stay
+         * legible against the fill instead of low-contrast on it. */
+        struct cairo_color row_muted = muted;
+        if (highlighted) {
+            bm_cairo_color_from_menu_color(menu, BM_COLOR_HIGHLIGHTED_BG, &bg);
+            bm_cairo_rounded_path(cairo->cr, pad_x, posy, width - pad_x * 2, row_h, 8.0);
+            cairo_set_source_rgba(cairo->cr, bg.r, bg.b, bg.g, bg.a);
+            cairo_fill(cairo->cr);
+            bm_cairo_color_from_menu_color(menu, BM_COLOR_HIGHLIGHTED_FG, &fg);
+            row_muted = fg;
+            row_muted.a *= 0.65f;
+        } else {
+            bm_cairo_color_from_menu_color(menu, BM_COLOR_ITEM_FG, &fg);
+        }
+
+        /* Both text lines and the icon share this left edge; the subtitle
+         * anchors here directly rather than past the icon+title indent. */
+        const int32_t text_x = (int32_t)(pad_x + gutter);
+        int32_t x = text_x;
+
+        const char *icon = bm_item_get_icon(item);
+        if (icon && *icon) {
+            cairo_surface_t *surface = bm_cairo_icon_load(icon, icon_size);
+            if (surface) {
+                /* Centred against line 1's half of the slot, not the row. */
+                cairo_save(cairo->cr);
+                cairo_set_source_surface(cairo->cr, surface, x, posy + (row_h / 2.0 - icon_size) / 2.0);
+                cairo_paint(cairo->cr);
+                cairo_restore(cairo->cr);
+            }
+            x += (int32_t)(icon_size + gap);
+        }
+
+        const int32_t right_limit = (int32_t)(width - pad_x - gutter);
+        const int32_t line1_baseline = (int32_t)(posy + row_h * 0.40);
+        const int32_t line2_baseline = (int32_t)(posy + row_h * 0.78);
+
+        /* The accessory lives on line 1 only and owns its width outright;
+         * the title fills whatever line 1 has left of it. */
+        const char *accessory = bm_item_get_accessory(item);
+        int32_t title_limit = right_limit;
+        if (accessory && *accessory) {
+            uint32_t aw = bm_cairo_run_width(cairo, paint, accessory);
+            bm_cairo_draw_run(cairo, paint, &row_muted, accessory,
+                              right_limit - (int32_t)aw, line1_baseline, (int32_t)aw, false);
+            title_limit = right_limit - (int32_t)aw - (int32_t)gap;
+        }
+
+        bm_cairo_draw_run(cairo, paint, &fg, bm_item_get_text(item),
+                          x, line1_baseline, title_limit - x, true);
+
+        /* Line 2, full row width from text_x: the subtitle never shares
+         * line 1's accessory-narrowed budget. */
+        const char *subtitle = bm_item_get_subtitle(item);
+        if (subtitle && *subtitle) {
+            bm_cairo_draw_run(cairo, paint, &row_muted, subtitle,
+                              text_x, line2_baseline, right_limit - text_x, true);
+        }
+
+        posy += row_h;
+        out_result->height = posy;
+        out_result->displayed++;
+    }
+}
+
