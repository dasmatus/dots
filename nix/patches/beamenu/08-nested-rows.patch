diff --git a/lib/renderers/rows.cpp b/lib/renderers/rows.cpp
new file mode 100644
index 0000000..1d88f56
--- /dev/null
+++ b/lib/renderers/rows.cpp
@@ -0,0 +1,59 @@
+/**
+ * Variable-height row layout.
+ *
+ * Split out of cairo_renderer.h for the same reason pills.cpp was: it is pure
+ * arithmetic over an array of heights, with no cairo context, no pango
+ * measurement and no menu state, which makes it the part worth testing on its
+ * own. Nothing here touches the STL, exceptions or RTTI, so the archive links
+ * into the C renderers without pulling libstdc++.
+ */
+
+#include "renderers/rows.h"
+
+#include <cstdint>
+
+extern "C" struct bm_rows_window
+bm_rows_fit(const std::uint32_t *heights, std::uint32_t count, std::uint32_t highlight, std::uint32_t viewport)
+{
+    struct bm_rows_window window = { 0, 0, 0 };
+    if (!heights || count == 0)
+        return window;
+
+    /* A highlight past the end is the caller's index against a list that has
+     * since shrunk. Clamp rather than read off the end of the array. */
+    if (highlight >= count)
+        highlight = count - 1;
+
+    /* Cut the list into pages greedily from the top, each as tall as fits,
+     * and return the page the highlight lands on.
+     *
+     * Paging rather than scrolling by the least amount that brings the
+     * highlight on screen, which sounds better and is not: with no memory of
+     * where the list was scrolled last frame, "the least amount" pins the
+     * highlight to whichever edge it entered from, so walking back up a long
+     * list drags the whole run one row at a time and never shows what is
+     * above it. Pages hold still until the highlight leaves one, which is the
+     * behaviour the uniform-height code had and the only one reachable
+     * without carrying scroll state across frames.
+     */
+    std::uint32_t first = 0;
+    for (;;) {
+        std::uint32_t last = first;
+        std::uint32_t used = heights[first];
+        while (last + 1 < count && used + heights[last + 1] <= viewport) {
+            used += heights[last + 1];
+            ++last;
+        }
+
+        if (highlight <= last) {
+            window.first = first;
+            window.count = last - first + 1;
+            window.height = used;
+            return window;
+        }
+
+        /* `last` never precedes `first`, so this always advances even when a
+         * single row is taller than the viewport and the page holds just it. */
+        first = last + 1;
+    }
+}
diff --git a/lib/renderers/rows.h b/lib/renderers/rows.h
new file mode 100644
index 0000000..b6408db
--- /dev/null
+++ b/lib/renderers/rows.h
@@ -0,0 +1,52 @@
+#ifndef _BM_ROWS_H_
+#define _BM_ROWS_H_
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Which rows of a variable-height run are on screen, and how tall they are.
+ */
+struct bm_rows_window {
+    /** Index of the first row to draw. */
+    uint32_t first;
+    /** How many rows from `first` fit, at least 1 whenever any row exists. */
+    uint32_t count;
+    /** Pixels those rows occupy together. */
+    uint32_t height;
+};
+
+/**
+ * Fit a run of rows of differing heights into `viewport`, keeping `highlight`
+ * visible.
+ *
+ * Rows stopped being uniform when nested ones started drawing shorter than
+ * their parents, and paging by a row count stopped working with them: whole
+ * pages only line up when every row is the same height. This scrolls by the
+ * least amount that brings the highlight on screen instead, then fills
+ * whatever room is left below it.
+ *
+ * The result's `height` is what the panel should be, so the caller sizes
+ * itself from the rows it will actually draw rather than from a row count
+ * multiplied by an assumed height. Without that the panel keeps the height of
+ * the tallest possible list and leaves a gap under the last short row.
+ *
+ * A viewport too small for even the highlighted row still reports `count` 1,
+ * because showing one clipped row beats showing an empty panel.
+ *
+ * @param heights height in pixels of each row, in draw order.
+ * @param count number of entries in `heights`.
+ * @param highlight index of the row that must stay visible.
+ * @param viewport pixels available to the run.
+ * @return struct bm_rows_window the rows to draw and their total height.
+ */
+struct bm_rows_window bm_rows_fit(const uint32_t *heights, uint32_t count, uint32_t highlight, uint32_t viewport);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _BM_ROWS_H_ */
