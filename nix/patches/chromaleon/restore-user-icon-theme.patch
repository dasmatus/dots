(derivative of ChromaLeon's own GPL-3.0-or-later extension.js/themeUtils.js;
see REUSE.toml's override block for nix/patches/chromaleon/**)

--- a/extension.js
+++ b/extension.js
@@ -43,6 +43,13 @@
     this._cancellable = null;
     this._opChain = Promise.resolve();
     this._customStylesheet = null;
+    // Icon theme active before this extension ever touched the key. See the
+    // capture site in enable() for why this exists at all: upstream's
+    // disable() and updateIconPack() both reset unconditionally to the
+    // literal string "Adwaita", which is wrong on any desktop that wasn't
+    // using Adwaita to begin with (Papirus-Dark on this host, but the bug is
+    // general).
+    this._originalIconTheme = null;
   }
 
   enable() {
@@ -57,6 +64,27 @@
       schema_id: "org.gnome.desktop.interface",
     });
 
+    // Capture whatever icon theme was active BEFORE this extension does
+    // anything to the key, so disable() and updateIconPack()'s
+    // recolor-folders-off path (utils/themeUtils.js) can hand the user back
+    // their own theme instead of upstream's hardcoded "Adwaita" -- which is
+    // wrong for any desktop that starts from something else (this host runs
+    // Papirus-Dark; nix/home/base/gnome-extensions.nix pins recolor-folders
+    // to false precisely because ChromaLeon's icon engine is a verified
+    // no-op there, but a manual prefs toggle can still flip it on at
+    // runtime, and that path must not evict Papirus-Dark permanently).
+    //
+    // Skip capturing when the stored value is already "ChromaLeon": that
+    // only happens when GNOME Shell restarts (or the extension is
+    // disabled/re-enabled) while ChromaLeon's own synthetic theme is still
+    // active, and re-capturing at that moment would immortalize
+    // "ChromaLeon" as its own restore target -- the exact bug this patch
+    // exists to remove, just moved one step later.
+    const currentIconTheme = this._interfaceSettings.get_string("icon-theme");
+    if (currentIconTheme !== "ChromaLeon") {
+      this._originalIconTheme = currentIconTheme;
+    }
+
     this._bgSettings = new Gio.Settings({
       schema_id: "org.gnome.desktop.background",
     });
@@ -260,7 +288,15 @@
     }
 
     if (this._interfaceSettings?.get_string("icon-theme") === "ChromaLeon") {
-      this._interfaceSettings.set_string("icon-theme", "Adwaita");
+      // this._originalIconTheme || "Adwaita", NOT the bare literal upstream
+      // had here: this is the one line that decided this patch was needed
+      // at all. On a Papirus-Dark host, the literal would silently permanently
+      // swap the icon theme to Adwaita the very first time recolor-folders
+      // was ever toggled on and back off again.
+      this._interfaceSettings.set_string(
+        "icon-theme",
+        this._originalIconTheme || "Adwaita",
+      );
     }
 
     this._reloadGtkStylesheet();
@@ -274,6 +310,7 @@
     this._interfaceSettings = null;
     this._a11ySettings = null;
     this._savedColorScheme = null;
+    this._originalIconTheme = null;
   }
 
   _runOperation(fn) {
@@ -374,6 +411,7 @@
         iconApps,
         morewaita,
         gnomeColors,
+        this._originalIconTheme,
         cancellable,
       );
     } catch (error) {
--- a/utils/themeUtils.js
+++ b/utils/themeUtils.js
@@ -494,6 +494,7 @@
   iconApps,
   morewaita,
   gnomeColors,
+  originalIconTheme,
   cancellable,
 ) {
   throwIfCancelled(cancellable);
@@ -515,7 +516,12 @@
   });
 
   if (!iconFolders && settings.get_string("icon-theme") === "ChromaLeon") {
-    settings.set_string("icon-theme", "Adwaita");
+    // Same fix as extension.js's disable(): restore the theme the caller
+    // remembered instead of the bare "Adwaita" upstream had here. This
+    // function is otherwise stateless, so the value has to arrive as a
+    // parameter (threaded from extension.js's this._originalIconTheme) --
+    // there is nothing in this module to remember it between calls.
+    settings.set_string("icon-theme", originalIconTheme || "Adwaita");
     return;
   }
