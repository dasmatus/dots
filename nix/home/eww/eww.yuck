; Static keybind data is generated by nix/home/keybinds.nix into keybinds.json
; and polled once per hour.
(defpoll keybinds_data :interval "1h" "cat ~/.config/eww/keybinds.json")

(defwindow keybinds
  :monitor 0
  :geometry (geometry :x "0%" :y "0%" :width "900px" :height "80%" :anchor "center")
  :stacking "overlay"
  :focusable false
  :exclusive false
  (keybinds_widget))

(defwidget keybinds_widget []
  (box :orientation "vertical" :class "keybinds"
    (box :class "keybinds-header" :spacing 12
      (label :text "Keyboard shortcuts" :class "keybinds-title" :hexpand true)
      (button :class "close-btn" :onclick "eww close keybinds" "×"))
    (scroll
      :hexpand true
      :vexpand true
      (box :orientation "vertical" :class "keybinds-list" :spacing 20
        (for item in keybinds_data
          (box :orientation "vertical" :class "kb-entry"
            (label :text "${item.category}" :class "kb-category" :visible {item.first})
            (box :orientation "horizontal" :class "kb-row" :spacing 16
              (label :text "${item.key}" :class "kb-key")
              (label :text "${item.desc}" :class "kb-desc" :hexpand true))))))))
