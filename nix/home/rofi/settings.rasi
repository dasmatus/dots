/*
 * ROFI color theme — Tokyonight settings menu (rust/settings-global via
 * nix/home/settings-menu.nix, SUPER+comma).
 *
 * Same palette as tokyonight.rasi, different shape: the Spotlight grid is
 * built for icons, this is a compact centered vertical list of
 * "label: value" rows (7 menu entries), reused by the value-input prompts
 * (-l 0 hides the list, leaving just the bar) and the -e error dialogs.
 * No icons — the rows are text-only. Static Tokyonight on purpose: the
 * wallpaper-tui tint pipeline only regenerates the launcher theme
 * (tint/rofi.rasi), and a system-settings dialog reads better stable.
 */

configuration {
  font: "Lilex Nerd Font Bold 12";
  show-icons: false;

  timeout {
    delay: 15;
    action: "kb-cancel";
  }
}

* {
  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;

  bg:          #1a1b26;
  bg-alt:      #232433;
  fg:          #6a6f87;
  fg-alt:      #a9b1d6;
  accent:      #7aa2f7;
  selected-bg: #2d3252;

  background-color: @bg;
  text-color:       @fg;
}

window {
  transparency: "real";
  /* Wide enough that a "Git email: <addr>" or "Hostname: <name>" row shows
     the whole value without rofi ellipsizing it in the list. */
  width:        640px;
  location:     center;
  anchor:       center;
  border-radius: 16px;
}

mainbox {
  children: [inputbar, message, listview];
  padding:  16px;
  spacing:  12px;
}

inputbar {
  background-color: @bg-alt;
  border-radius:    12px;
  children:         [prompt, entry];
}

entry {
  background-color: inherit;
  padding:          14px 8px;
  text-color:       @fg-alt;
}

prompt {
  background-color: inherit;
  padding:          14px;
  text-color:       @accent;
}

/* rofi -e error dialogs render through message/textbox */
message {
  background-color: @bg-alt;
  border-radius:    12px;
}

textbox {
  background-color: inherit;
  padding:          14px;
  text-color:       @fg-alt;
}

listview {
  columns: 1;
  lines:   7;
  cycle:   true;
  dynamic: true;
  layout:  vertical;
  spacing: 4px;
}

element {
  orientation:   horizontal;
  children:      [element-text];
  padding:       12px 14px;
  border-radius: 10px;
  cursor:        pointer;
}

element selected {
  background-color: @selected-bg;
}

element-text {
  horizontal-align: 0.0;
  vertical-align:   0.5;
  cursor:           inherit;
}

element-text selected {
  text-color: @fg-alt;
}
