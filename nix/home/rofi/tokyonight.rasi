/*
 * ROFI color theme — Tokyonight Spotlight grid for the file manager and
 * power menu.
 *
 * The app launcher has moved to eww (nix/home/eww). This theme is now used
 * only by rofi-files.sh and rofi-power-menu: a 4×2 icon grid below a wide,
 * rounded search bar pinned to the upper third of the screen.
 */

configuration {
  font: "Lilex Nerd Font Bold 12";
  show-icons: true;
  icon-theme: "MoreWaita";

  drun {
    display-name: "";
  }

  run {
    display-name: "";
  }

  window {
    display-name: "";
  }

  timeout {
    delay: 10;
    action: "kb-cancel";
  }
}

* {
  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;

  bg:          #1a1b26;
  bg-alt:      #232433;
  fg:          #6a6f87;
  fg-alt:      #a9b1d6;
  accent:      #7aa2f7;
  selected-bg: #2d3252;

  background-color: @bg;
  text-color:       @fg;
}

window {
  transparency: "real";
  width:        720px;
  location:     north;
  anchor:       north;
  x-offset:     0px;
  y-offset:     120px;
  border-radius: 16px;
}

mainbox {
  children: [inputbar, listview];
  padding:  16px;
  spacing:  16px;
}

inputbar {
  background-color: @bg-alt;
  border-radius:    12px;
  children:         [prompt, entry];
}

entry {
  background-color: inherit;
  padding:          16px 8px;
}

prompt {
  background-color: inherit;
  padding:          16px;
  text-color:       @accent;
}

listview {
  columns:  4;
  lines:    2;
  cycle:    true;
  dynamic:  true;
  layout:   vertical;
  spacing:  10px;
}

element {
  orientation:  vertical;
  children:     [element-icon, element-text];
  padding:      14px 8px;
  border-radius: 12px;
  cursor:       pointer;
}

element selected {
  background-color: @selected-bg;
}

element-icon {
  size:             56px;
  horizontal-align: 0.5;
  cursor:           inherit;
}

element-text {
  horizontal-align: 0.5;
  vertical-align:   0.5;
  padding:          8px 0 0 0;
  font:             "Lilex Nerd Font Bold 10";
  cursor:           inherit;
}

element-text selected {
  text-color: @fg-alt;
}
